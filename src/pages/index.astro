---
// Component Script
const companyInfo = {
  name: "DeRIVE Innovation",
  tagline: "Engineering & Digital Solutions for a Better Tomorrow",
  address: "653/37 ถนนจรัญสนิทวงศ์ บางกอกน้อย กรุงเทพฯ 10700",
  phone: "+66 (81) 492-6996",
  email: "derive.in8@derive.co.th",
  contactPerson: "คุณกัญญารัตน์",
  facebook: "https://www.facebook.com/deriveinnovation/"
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{companyInfo.name}</title>

  <!-- Google Font (clean + professional) -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --text: #111827;
      --muted: #6b7280;
      --border: #e5e7eb;
      --bg: #f9fafb;
      --primary: #2563eb;
    }

    body {
      font-family: 'Inter', sans-serif;
      margin: 0;
      background: var(--bg);
      color: var(--text);
    }

    .container {
      max-width: 1100px;
      margin: auto;
      padding: 40px 20px;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 60px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 20px;
    }

    .logo {
      font-weight: 600;
      font-size: 1.2rem;
    }

    .nav-links {
      display: flex;
      gap: 30px;
      align-items: center;
    }

    .nav-links a {
      text-decoration: none;
      color: var(--text);
      font-size: 0.95rem;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--primary);
    }

    .nav-links a.active {
      color: var(--primary);
      font-weight: 600;
    }

    .contact-link {
      font-size: 0.9rem;
      color: var(--primary);
      text-decoration: none;
    }

    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
      margin-bottom: 80px;
    }

    .hero h1 {
      font-size: 3rem;
      line-height: 1.2;
      margin-bottom: 20px;
    }

    .hero p {
      color: var(--muted);
      font-size: 1.1rem;
      max-width: 400px;
    }

    .hero img {
      width: 100%;
      border-radius: 8px;
    }

    .section-title {
      text-align: center;
      margin-bottom: 40px;
    }

    .section-title h2 {
      font-size: 1rem;
      letter-spacing: 0.1em;
      color: var(--muted);
    }

    .contact-list {
      max-width: 600px;
      margin: auto;
      border-top: 1px solid var(--border);
    }

    .contact-item {
      display: flex;
      gap: 20px;
      padding: 20px 0;
      border-bottom: 1px solid var(--border);
    }

    .icon {
      font-size: 20px;
      width: 24px;
    }

    .label {
      font-size: 0.75rem;
      color: var(--muted);
      text-transform: uppercase;
      margin-bottom: 5px;
    }

    .value {
      font-size: 1rem;
      font-weight: 500;
    }

    a {
      color: var(--primary);
      text-decoration: none;
    }

    footer {
      text-align: center;
      margin-top: 60px;
      font-size: 0.8rem;
      color: var(--muted);
    }

    @media (max-width: 768px) {
      header {
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
      }

      .nav-links {
        width: 100%;
        flex-direction: column;
        gap: 15px;
      }

      .hero {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        font-size: 2rem;
      }
    }
  </style>
</head>

<body>
  <div class="container">

    <!-- Header -->
    <header>
      <div class="logo">{companyInfo.name}</div>
      <nav class="nav-links">
        <a href="/" class="active">Home</a>
        <a href="/products">Products</a>
        <a href="/site-references">Site References</a>
        <a href="/resources">Resources</a>
        <a href="#contact" class="contact-link">Contact</a>
      </nav>
    </header>

    <!-- Hero -->
    <section class="hero">
      <div>
        <h1>
          DeRIVE <br />
          Innovation
        </h1>
        <p>{companyInfo.tagline}</p>
      </div>

      <!-- Replace with your real image -->
      <img src="/hero.jpg" alt="Company Image" />
    </section>

    <!-- Contact Section -->
    <section id="contact">
      <div class="section-title">
        <h2>CONTACT INFORMATION</h2>
      </div>

      <div class="contact-list">

        <div class="contact-item">
          <div class="icon">📍</div>
          <div>
            <div class="label">Address</div>
            <div class="value">{companyInfo.address}</div>
          </div>
        </div>

        <div class="contact-item">
          <div class="icon">📞</div>
          <div>
            <div class="label">Phone</div>
            <div class="value">
              <a href={`tel:${companyInfo.phone}`}>{companyInfo.phone}</a>
            </div>
          </div>
        </div>

        <div class="contact-item">
          <div class="icon">✉️</div>
          <div>
            <div class="label">Contact</div>
            <div class="value">
              {companyInfo.contactPerson} ·
              <a href={`mailto:${companyInfo.email}`}>{companyInfo.email}</a>
            </div>
          </div>
        </div>

        <div class="contact-item">
          <div class="icon">👍</div>
          <div>
            <div class="label">Follow</div>
            <div class="value">
              <a href={companyInfo.facebook} target="_blank">
                Visit Facebook Page
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Footer -->
    <footer>
      © {new Date().getFullYear()} {companyInfo.name}. All rights reserved.
    </footer>

  </div>
</body>
</html>
